<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Plain HTTP, for a debug build only.
         The real manifest sets usesCleartextTraffic="false" and that is what
         ships: a session token travelling in the clear over café Wi-Fi is the
         whole of an account. But development runs the backend on a laptop
         without a certificate, so the debug build — which cannot be uploaded
         to Play and is not what anybody installs — is allowed it.
         `tools:replace` is needed because the main manifest states the
         opposite; without it the merge fails rather than picking one. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
