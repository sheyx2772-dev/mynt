<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later ask separately about two ways data leaves a phone:
  a cloud backup, and a direct transfer to a new device. Both are refused.

  The app keeps a session token, and a session is meant to belong to one
  device. Restoring it onto another one hands over an account without anybody
  signing in — which is exactly what a person selling an old phone would not
  expect to have done. Signing in again takes fifteen seconds.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
