# The backend. Everything about a person, a number or a payment is decided
# there; this app renders pages and asks. Nothing here holds a database key or
# a merchant secret, because nothing here makes a decision that would need one.
BACKEND_URL=http://127.0.0.1:8090

# The origin this site answers on, used to build the absolute addresses that
# come back to it — the profile a QR code encodes, above all. Not a secret: it
# is the domain printed on the cards. Left unset it falls back to the
# production origin rather than to whatever a request claimed its host was.
NEXT_PUBLIC_SITE_URL=
