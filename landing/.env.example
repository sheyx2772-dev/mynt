# The backend. Everything about a person, a number, a payment or a notice is
# decided there; this app renders pages and asks. Nothing here holds a database
# key, a merchant secret or a bot token, because nothing here makes a decision
# that would need one.
BACKEND_URL=http://127.0.0.1:8090

# Absolute origin used to build links that come back to this app.
# Optional in development — falls back to the request's own host.
NEXT_PUBLIC_SITE_URL=

# Rasm saqlash — ishlab chiqishda MinIO (backend: make minio), prodakshnda R2.
# S3_ENDPOINT bo'sh bo'lsa R2_ACCOUNT_ID dan Cloudflare manzili yasaladi.
S3_ENDPOINT=
S3_REGION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google AI Studio — used to generate a card design from a buyer's description.
# Get one at https://aistudio.google.com/apikey. Image generation is billed per
# image; set a monthly spend cap on the project so a loop cannot run up a bill.
GEMINI_API_KEY=

# The bot's name without the @ — shown as a link on the linking screen. The
# token itself lives in the backend, which is what actually sends.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# Working the design queue with scripts/designs.py. An ordinary administrator
# sign-in — the same door the panel uses. Leave the password out of the file and
# pass it for one run: ADMIN_PASSWORD=... python3 scripts/designs.py list
ADMIN_EMAIL=
ADMIN_PASSWORD=
