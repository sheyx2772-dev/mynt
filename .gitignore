# Four applications, four sets of build output. The patterns are unanchored so
# they match at any depth rather than only at the root — `node_modules` now
# exists in two places and neither of them is here.

# Node
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next
.next/
out/
next-env.d.ts

# Vite
dist/

# Go — the compiled binary, if it is built in place
/backend/flex
/backend/bin/

# Flutter
.dart_tool/
.flutter-plugins-dependencies
build/
*.iml
# Local Android and iOS build settings, which name paths on one machine.
/mobile/android/local.properties
/mobile/android/.gradle/
/mobile/ios/Pods/
/mobile/ios/.symlinks/
/mobile/ios/Flutter/Flutter.podspec
/mobile/ios/Flutter/flutter_export_environment.sh
/mobile/ios/Flutter/Generated.xcconfig

# Testing
coverage/

# Secrets. Every application reads its own .env; none of them is committed.
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Editors and operating systems
.DS_Store
*.pem
.idea/
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# PowerPoint leaves these beside a file it has open.
~$*
