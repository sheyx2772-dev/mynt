# Copy to ~/backend/.env on the server and fill in. Never committed.

DOMAIN_NAME=api.flex-nfc.uz
SITE_URL=https://flex-nfc.uz

# Anything but "production" loosens the server: sign-in links and SMS codes go
# to the log instead of to a provider. Only for a first bring-up against an
# empty database — never with a real customer in it.
APP_ENV=production

# openssl rand -base64 32
POSTGRES_PASSWORD=

# Who may open the admin panel, by address, comma separated.
ADMIN_EMAILS=
# The one account that may open the fulfilment queue. Empty closes it to all.
OPERATOR_USER_ID=

# Sign-in. Production refuses to start without these: the fallback writes live
# links and codes to the log, which is not a thing to do near real customers.
RESEND_API_KEY=
MAIL_FROM=Flex <kirish@flex-nfc.uz>
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_FROM=4546

# The merchant cabinets must point at https://$DOMAIN_NAME/payme and
# /click/prepare, /click/complete. With no secret key those routes are not
# registered at all, so a provider gets a 404 rather than a retry storm.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=99108
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
# Any long random string; the daily reminder run is refused without it.
CRON_SECRET=
