# Copy to /opt/flex/.env on the server and fill in. Never committed: this file
# holds only the names.
#
# These live on the machine rather than in GitHub Secrets on purpose. A deploy
# does not need the database password, and a repository that is compromised
# should not hand over the payment keys with it.

# ── Where it runs ────────────────────────────────────────────────────────────
SITE_HOST=flex.com.uz
API_HOST=api.flex.com.uz
PANEL_HOST=admin.flex.com.uz
SITE_URL=https://flex.com.uz
ACME_EMAIL=

# ── Database ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Who runs it ──────────────────────────────────────────────────────────────
# Admin panel access, by address, comma separated.
ADMIN_EMAILS=
# The account id that may open the fulfilment queue. Empty closes it to all.
OPERATOR_USER_ID=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Without these the server refuses to start in production: the fallback writes
# live sign-in links and codes to the log, which is not a thing to do near real
# customers.
RESEND_API_KEY=
MAIL_FROM=Flex <kirish@flex.com.uz>
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_FROM=4546

# ── Payments ─────────────────────────────────────────────────────────────────
# The merchant cabinets must point at https://$API_HOST/payme and
# /click/prepare, /click/complete. With no secret key the callbacks are not
# registered at all and a provider gets a 404 rather than a retry storm.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=99108
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Any long random string; the daily reminder run is refused without it.
CRON_SECRET=

# ── Images ───────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Card design generation ───────────────────────────────────────────────────
GEMINI_API_KEY=
