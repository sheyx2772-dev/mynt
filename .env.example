# Supabase — Settings > API in your project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token used by `npm run db:migrate` to apply schema changes.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Absolute origin used to build sign-in links that come back to this app.
# Optional in development — falls back to the request's own host.
NEXT_PUBLIC_SITE_URL=

# Salt for the visitor hash used by analytics. Falls back to the service role
# key when unset; set it to any long random string in production.
ANALYTICS_SALT=

# Cloudflare R2 — for storing images (profile photos, card art, etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google AI Studio — used to generate a card design from a buyer's description.
# Get one at https://aistudio.google.com/apikey. Image generation is billed per
# image; set a monthly spend cap on the project so a loop cannot run up a bill.
GEMINI_API_KEY=

# Click Merchant (SHOP API) — merchant kabinetidan
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Payme Merchant API — kassa sozlamalaridan
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Telegram xabarnomalari. Token @BotFather dan olinadi (/newbot).
# Bo'sh qoldirilsa xabarlar baribir yoziladi, faqat hech qayerga yuborilmaydi.
TELEGRAM_BOT_TOKEN=
# Botning @ siz nomi — ulash sahifasida havola qilib ko'rsatiladi.
# Signing in through Telegram needs both of these. Without them the sign-in
# page shows only the email door — nothing breaks, it just offers less.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# Kunlik eslatma vazifasi uchun. Istalgan uzun tasodifiy satr; Vercel'da ham
# xuddi shu qiymat turishi kerak. Bo'sh bo'lsa vazifa hech kimni kiritmaydi.
CRON_SECRET=
