# Supabase — Settings > API in your project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used to build sign-in links that come back to this app.
# Optional in development — falls back to the request's own host.
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 — for storing images (profile photos, card art, etc.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
