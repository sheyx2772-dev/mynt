# Copy to .env and fill in. The file is git-ignored; nothing here has a value
# in it, and nothing with a value belongs in the repository.

# Postgres. The one setting with no default and no degraded mode.
DATABASE_URL=postgres://flex:flex@127.0.0.1:5432/flex?sslmode=disable

# "development" turns on readable logs and lets sign-in links go to the log
# instead of to a mail provider. Anything else — including a typo — is treated
# as production, so a mistake tightens the server rather than opening it.
APP_ENV=development

ADDR=:8090

# Where the browser-facing site is. Sign-in links are built from this and never
# from a request header: a Host an attacker controls would otherwise end up
# inside a one-time link mailed to a victim.
SITE_URL=http://localhost:3000

# Sending the sign-in mail. resend.com → API Keys.
#
# Without it, links are written to the log — which is what development wants and
# what production must never do, so the server refuses to start in production
# with this empty.
RESEND_API_KEY=
MAIL_FROM=Flex <kirish@flex-nfc.uz>

# Whether X-Forwarded-For may be believed. Leave false unless something trusted
# — Caddy, nginx, a load balancer — sets it: a client can put anything in that
# header, and believing it turns every rate limit into no limit at all.
TRUST_PROXY=false

# Who may use the admin panel, by address, separated by commas.
#
# A list here rather than a table because there is one company running this and
# the list is two lines long. Empty means nobody, which is the safe direction: a
# deployment that forgot this has no admin rather than an open one.
ADMIN_EMAILS=

# Which payment providers can take money. The identifiers, which go into the
# checkout address a buyer is sent to; the secret keys are below.
#
# With neither set, development gives a number away free and production refuses
# to sell at all rather than doing the same.
PAYME_MERCHANT_ID=
CLICK_SERVICE_ID=99108
CLICK_MERCHANT_ID=

# The secret keys, which verify a callback rather than build a link.
#
# This is now the only implementation of that protocol — the website's copy is
# gone — so the merchant cabinets point here: https://<this host>/payme and
# /click/prepare, /click/complete. Each provider holds one callback URL per
# merchant account, so exactly one deployment may hold these keys.
#
# With neither set, those routes are not registered at all: a provider gets a
# 404 rather than a signature error it will retry for hours.
PAYME_SECRET_KEY=
CLICK_SECRET_KEY=

# Sending the sign-in code by SMS. eskiz.uz → hisob, then the API credentials.
#
# SMS_FROM is the sender name, and it has to be approved by the operator before
# anything but Eskiz's own test text will send. 4546 is their shared short
# number, which works while an approval is pending.
#
# Without ESKIZ_EMAIL the codes are written to the log, which is what
# development wants — and what production must never do, so the server refuses
# to start that way.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_FROM=4546

# Who runs the shop, by account id.
#
# The fulfilment queue lists what to manufacture and the addresses to post it
# to, which is other people's personal data. One account named here rather than
# a flag on a row: a column called `is_admin` is a column that can be set; an id
# that only exists in this file cannot be granted by anything the code does.
#
# Empty closes the queue to everybody, including the website's own screen for
# it — the safe direction for a deployment that has not been told who runs it.
OPERATOR_USER_ID=

# The daily reminder run, at POST /v1/eslatmalar.
#
# A scheduler calls a URL, which makes the URL the problem: anybody can request
# it, and a reminder sent by a stranger at three in the morning is a reminder
# wasted for the month. Any long random string; empty refuses everybody.
CRON_SECRET=

# The bot that carries notifications. @BotFather → /newbot.
#
# Empty means the Telegram channel is not built at all, so notices are still
# recorded and simply go nowhere — which is what development wants.
TELEGRAM_BOT_TOKEN=
