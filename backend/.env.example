# Copy to .env and fill in. The file is git-ignored; nothing here has a value
# in it, and nothing with a value belongs in the repository.

# Postgres. This is the one setting with no default and no degraded mode.
DATABASE_URL=postgres://flex:flex@127.0.0.1:5432/flex?sslmode=disable

# "development" turns on readable logs. Anything else — including a typo — is
# treated as production, so a mistake tightens the server rather than opening it.
APP_ENV=development

ADDR=:8090
